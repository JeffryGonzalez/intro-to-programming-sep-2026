      "updated": 1789583547566,
      "link": null,
      "locked": false,
      "text": "White Box - Know how your code is written. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "White Box - Know how your code is written. ",
