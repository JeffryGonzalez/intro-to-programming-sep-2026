{
  "openapi": "3.1.1",
  "info": {
    "title": "Shows.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:1337/"
    }
  ],
  "paths": {
    "/shows": {
      "get": {
        "tags": [
          "Shows.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShowSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shows.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShowCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/shows/{id}": {
      "get": {
        "tags": [
          "Shows.Api"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShowCreateRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "genre": {
            "maxLength": 40,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ShowSummary": {
        "required": [
          "id",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Shows.Api"
    }
  ]
}